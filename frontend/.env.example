# URL of the deployed FastAPI backend, e.g. https://api.yourdomain.com
# Falls back to the same origin in the browser if unset (useful when
# Vercel rewrites /api/:path* to the backend).
NEXT_PUBLIC_API_URL=

# Backend URL used by Next.js rewrites (/api/:path* -> this). On Vercel set
# this to the public backend URL. Defaults to localhost:8000 for local dev.
BACKEND_URL=
