# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_bd_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Security - ALWAYS set a strong secret in production.
# Set ENVIRONMENT=production to require it (the app refuses to boot without it).
ENVIRONMENT=development
JWT_SECRET_KEY=

# AI/LLM (optional - agents fall back to mock responses when unset)
OPENAI_API_KEY=
AI_MODEL=gpt-4

# Temporal (optional)
TEMPORAL_HOST=localhost:7233

# Comma-separated CORS allowlist (e.g. https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
